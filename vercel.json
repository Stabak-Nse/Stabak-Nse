{
  "version": 2,
  "routes": [
    {
      "src": "/api/data(.*)",
      "dest": "/api/data.js"
    },
    {
      "src": "/api/nse/(.*)",
      "dest": "/api/nse.js"
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache"
      },
      "dest": "/public/index.html"
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache"
      },
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
